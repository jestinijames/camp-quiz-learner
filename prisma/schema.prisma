generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model BibleVersion {
  id    Int         @id @default(autoincrement())
  name  String      @unique // e.g. "NIV", "ESV"
  books BibleBook[]
}

model BibleBook {
  id        Int            @id @default(autoincrement())
  name      String
  version   BibleVersion   @relation(fields: [versionId], references: [id])
  versionId Int
  chapters  BibleChapter[]

  quizInstances QuizInstance[] // ADD this line
}

model BibleChapter {
  id     Int          @id @default(autoincrement())
  number Int // Chapter number, e.g. 1, 2, ...
  book   BibleBook    @relation(fields: [bookId], references: [id])
  bookId Int
  verses BibleVerse[]
}

model BibleVerse {
  id        Int          @id @default(autoincrement())
  number    Int // Verse number inside chapter
  text      String // Verse text
  chapter   BibleChapter @relation(fields: [chapterId], references: [id])
  chapterId Int
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  password  String // hashed team password
  members   Member[]
  createdAt DateTime @default(now())
}

model Member {
  id     Int    @id @default(autoincrement())
  name   String
  team   Team   @relation(fields: [teamId], references: [id])
  teamId Int

  quizSessions QuizSession[]
  triviaViews  TriviaView[] // NEW: Track which trivia items user has seen
}

model QuizInstance {
  id          Int       @id @default(autoincrement())
  title       String
  description String? // Optional description
  book        BibleBook @relation(fields: [bookId], references: [id])
  bookId      Int

  // ADD these verse range fields
  fromChapter Int // Starting chapter
  fromVerse   Int // Starting verse  
  toChapter   Int // Ending chapter
  toVerse     Int // Ending verse

  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(true) // Control if quiz is open
  timeLimit Int? // Time limit in minutes (optional)
  createdBy Admin     @relation(fields: [adminId], references: [id])
  adminId   Int

  quizSessions QuizSession[]
  questions    Question[]
  triviaItems  TriviaItem[] // NEW: Generated trivia/feedback from this quiz
}

model QuizSession {
  id          Int          @id @default(autoincrement())
  quiz        QuizInstance @relation(fields: [quizId], references: [id])
  quizId      Int
  member      Member       @relation(fields: [memberId], references: [id])
  memberId    Int
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  totalScore  Int? // Final calculated score
  timeSpent   Int? // Time spent in seconds
  isSubmitted Boolean      @default(false) // Track submission status

  answers Answer[]

  @@unique([quizId, memberId]) // Ensure one attempt per member per quiz
}

model Question {
  id      Int          @id @default(autoincrement())
  quiz    QuizInstance @relation(fields: [quizId], references: [id])
  quizId  Int
  type    QuestionType // Use enum for better validation
  text    String
  options String? // JSON string for multiple choice options
  answer  String // Correct answer
  points  Int          @default(10)
  order   Int // Question order (1, 2, 3)

  answers     Answer[]
  triviaItems TriviaItem[] // NEW: Trivia generated from this question
}

enum QuestionType {
  FILL_IN_BLANK
  MULTIPLE_CHOICE
  DESCRIPTIVE
}

model Answer {
  id            Int         @id @default(autoincrement())
  quizSession   QuizSession @relation(fields: [quizSessionId], references: [id])
  quizSessionId Int
  question      Question    @relation(fields: [questionId], references: [id])
  questionId    Int
  response      String
  score         Int         @default(0)
  feedback      String?
  isCorrect     Boolean? // Quick boolean for correct/incorrect
  gradedBy      String? // "AUTO" or "LLM" or "MANUAL"
  createdAt     DateTime    @default(now())
}

// NEW: Trivia/Learning Items generated from quiz results
model TriviaItem {
  id         Int          @id @default(autoincrement())
  quiz       QuizInstance @relation(fields: [quizId], references: [id])
  quizId     Int
  question   Question?    @relation(fields: [questionId], references: [id])
  questionId Int? // Optional: link to specific question

  type    TriviaType // Type of trivia/feedback
  title   String // e.g., "Common Mistake: Genesis 1:1"
  content String // Main trivia content
  insight String? // Additional learning insight

  // Analytics data from the quiz
  totalAttempts  Int // How many people answered this question
  correctCount   Int // How many got it right
  incorrectCount Int // How many got it wrong
  commonMistakes String? // JSON array of common wrong answers

  // Learning recommendations
  suggestedReading String? // Bible passages to read
  studyTips        String? // Study suggestions

  // Publishing control
  isPublished Boolean   @default(false) // Admin can control when to show
  publishedAt DateTime?
  priority    Int       @default(1) // Display priority (1 = highest)

  createdAt DateTime @default(now())
  createdBy Admin    @relation(fields: [adminId], references: [id])
  adminId   Int

  triviaViews TriviaView[] // Track who has seen this trivia
}

enum TriviaType {
  COMMON_MISTAKE // "X% of people got this wrong"
  STUDY_TIP // "Consider reading this section"
  INTERESTING_FACT // "Did you know..."
  CLARIFICATION // "This answer means..."
  ENCOURAGEMENT // "Don't worry, this was tricky for most"
  CHALLENGE // "Only X% got this right - well done if you did!"
}

// NEW: Track which trivia items each user has viewed
model TriviaView {
  id         Int        @id @default(autoincrement())
  member     Member     @relation(fields: [memberId], references: [id])
  memberId   Int
  triviaItem TriviaItem @relation(fields: [triviaId], references: [id])
  triviaId   Int
  viewedAt   DateTime   @default(now())

  @@unique([memberId, triviaId]) // Ensure one view record per member per trivia
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())

  quizInstances QuizInstance[]
  triviaItems   TriviaItem[] // NEW: Track created trivia items
}

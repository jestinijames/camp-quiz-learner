generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model BibleVersion {
  id    Int         @id @default(autoincrement())
  name  String      @unique // e.g. "NIV", "ESV"
  books BibleBook[]
}

model BibleBook {
  id        Int            @id @default(autoincrement())
  name      String
  version   BibleVersion   @relation(fields: [versionId], references: [id])
  versionId Int
  chapters  BibleChapter[]

  quizInstances QuizInstance[] // ADD this line
}

model BibleChapter {
  id     Int          @id @default(autoincrement())
  number Int // Chapter number, e.g. 1, 2, ...
  book   BibleBook    @relation(fields: [bookId], references: [id])
  bookId Int
  verses BibleVerse[]
}

model BibleVerse {
  id        Int          @id @default(autoincrement())
  number    Int // Verse number inside chapter
  text      String // Verse text
  chapter   BibleChapter @relation(fields: [chapterId], references: [id])
  chapterId Int
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  password  String // hashed team password
  members   Member[]
  createdAt DateTime @default(now())
}

model Member {
  id     Int    @id @default(autoincrement())
  name   String
  team   Team   @relation(fields: [teamId], references: [id])
  teamId Int

  quizSessions    QuizSession[]
  triviaViews     TriviaView[]
  personalTrivia  TriviaItem[] // NEW: Personal trivia items
}

model QuizInstance {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  book        BibleBook @relation(fields: [bookId], references: [id])
  bookId      Int

  fromChapter Int
  fromVerse   Int
  toChapter   Int
  toVerse     Int

  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(true)
  timeLimit Int?
  createdBy Admin     @relation(fields: [adminId], references: [id])
  adminId   Int

  quizSessions QuizSession[]
  questions    Question[] // This will have 30 questions (10 of each type)
  triviaItems  TriviaItem[]
}

model QuizSession {
  id          Int          @id @default(autoincrement())
  quiz        QuizInstance @relation(fields: [quizId], references: [id])
  quizId      Int
  member      Member       @relation(fields: [memberId], references: [id])
  memberId    Int
  startTime   DateTime     @default(now()) // CHANGE from startedAt
  completedAt DateTime?
  totalScore  Int? // Final calculated score
  timeSpent   Int? // Time spent in seconds
  isSubmitted Boolean      @default(false) // Track submission status

  answers        Answer[]
  questionUsages QuestionUsage[]

  @@unique([quizId, memberId]) // Ensure one attempt per member per quiz
}

model Question {
  id       Int          @id @default(autoincrement())
  quiz     QuizInstance @relation(fields: [quizId], references: [id])
  quizId   Int
  type     QuestionType
  text     String
  options  String? // JSON for multiple choice
  answer   String
  points   Int          @default(10)
  order    Int // 1-10 for each type (Fill: 1-10, MC: 11-20, Desc: 21-30)
  verseRef String? // Which verse this question is about

  // For tracking which questions were used in sessions
  usedInSessions QuestionUsage[]
  answers        Answer[]
  triviaItems    TriviaItem[]
}

enum QuestionType {
  FILL_IN_BLANK
  MULTIPLE_CHOICE
  DESCRIPTIVE
}

model Answer {
  id         Int         @id @default(autoincrement())
  session    QuizSession @relation(fields: [sessionId], references: [id])
  sessionId  Int
  question   Question    @relation(fields: [questionId], references: [id])
  questionId Int // Which specific question from the pool
  response   String
  isCorrect  Boolean?
  points     Int?
  feedback   String?    // ADD THIS LINE - for AI correction feedback

  @@unique([sessionId, questionId])
}

// NEW: Track which specific questions each member got
model QuestionUsage {
  id         Int         @id @default(autoincrement())
  session    QuizSession @relation(fields: [sessionId], references: [id])
  sessionId  Int
  question   Question    @relation(fields: [questionId], references: [id])
  questionId Int

  @@unique([sessionId, questionId])
}

// NEW: Trivia/Learning Items generated from quiz results
model TriviaItem {
  id         Int          @id @default(autoincrement())
  quiz       QuizInstance @relation(fields: [quizId], references: [id])
  quizId     Int
  member     Member?      @relation(fields: [memberId], references: [id]) // NEW: Personal trivia
  memberId   Int?         // NEW: Which member this trivia is for
  question   Question?    @relation(fields: [questionId], references: [id])
  questionId Int? // Optional: link to specific question

  type    TriviaType // KEEP AS ENUM - don't change to String!
  title   String
  content String
  insight String? // Personal note
  
  // Learning recommendations
  suggestedReading String? // Bible passages to read
  studyTips        String? // Study suggestions

  // Publishing control
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  priority    Int       @default(1)

  createdAt DateTime @default(now())
  createdBy Admin    @relation(fields: [adminId], references: [id])
  adminId   Int

  triviaViews TriviaView[]
}

enum TriviaType {
  INSIGHT
  ENCOURAGEMENT  
  STUDY_TIP
  BIBLICAL_CONNECTION
  COMMON_MISTAKE
  CHALLENGE
}

// NEW: Track which trivia items each user has viewed
model TriviaView {
  id         Int        @id @default(autoincrement())
  member     Member     @relation(fields: [memberId], references: [id])
  memberId   Int
  triviaItem TriviaItem @relation(fields: [triviaId], references: [id])
  triviaId   Int
  viewedAt   DateTime   @default(now())

  @@unique([memberId, triviaId]) // Ensure one view record per member per trivia
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())

  quizInstances QuizInstance[]
  triviaItems   TriviaItem[] // NEW: Track created trivia items
}
